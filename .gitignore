# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Local configuration & secrets (never commit)
.env
.env.local
.secrets/
*.cookies

# Runtime state (device registry, Amazon session, Tailscale state)
state/
ts/

# Sphinx / docs build output (sphinx/ is the source; _build/ is regenerated)
sphinx/_build/
sphinx/_templates/
# docs/ is tracked (Wiki content in Markdown); Sphinx HTML build output is not
docs/*.html
docs/*.js
docs/*.inv
docs/.buildinfo
docs/.doctrees/
docs/_sources/
docs/_static/
docs/_images/
docs/.gitkeep
docs/.nojekyll
docs/searchindex.js

# Docker / build
docker-compose.yaml
# OS
.DS_Store
Thumbs.db

# Local task list (not part of the release)
to-do.md

# Tests
# __pycache__ inside tests is ignored by the global __pycache__/ rule above.
