# castNavidrome - example configuration
# Copy this file to .env and fill in your own values.  Never commit .env.

# ---- Service ----
SERVICE=castnavidrome

# ---- Network ----
SERVICEPORT=5000
DNS_SERVER=9.9.9.9
TZ=Europe/Berlin

# ---- Navidrome (Subsonic API) ----
# Your publicly accessible Navidrome URL, https://, no trailing slash.
NAVI_URL=https://navidrome.example.test
# Publicly accessible URL of this skill (used for cover art on Alexa cards).
NAVI_BASE_URL=https://castnavidrome.example.test
NAVI_USER=your-navidrome-username
NAVI_PASS=your-navidrome-password
NAVI_PORT=443
NAVI_API_PATH=/rest
NAVI_API_VER=1.16.1
NAVI_SONG_COUNT=50

# ---- Alexa skill ----
# Skill ID from the Amazon Alexa Developer Console (skill URL).
NAVI_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# Invocation name of the skill you created (avoid names easily confused with other skills).
NAVI_ALEXA_SKILL_NAME=castnavidrome
NAVI_ALEXA_DOMAIN=amazon.com
NAVI_ALEXA_LOCALE=de-DE
# API key for the optional /api/alexa/* endpoints. Generate with: openssl rand -hex 32
NAVI_ALEXA_API_KEY=your-api-key-here

# ---- Media renderer (UPnP) ----
NAVI_ALEXA_RENDERER_ENABLED=yes
NAVI_ALEXA_RENDERER_ADVERTISE_HOST=
NAVI_ALEXA_RENDERER_PORT=49443
NAVI_ALEXA_RENDERER_REFRESH_SECONDS=300
NAVI_ALEXA_RENDERER_MIN_REFRESH_SECONDS=60
NAVI_ALEXA_RENDERER_NAME_PREFIX=
NAVI_ALEXA_RENDERER_DEVICE_TYPES=
NAVI_ALEXA_RENDERER_EXCLUDED_DEVICE_TYPES=
NAVI_ALEXA_RENDERER_NAME_INCLUDE=
NAVI_ALEXA_RENDERER_NAME_EXCLUDE=
NAVI_ALEXA_RENDERER_NAME_REGEX=
NAVI_ALEXA_RENDERER_ONLY_ONLINE=no
NAVI_ALEXA_RENDERER_ANNOUNCE=explicit
NAVI_ALEXA_RENDERER_LOG_LEVEL=INFO
NAVI_ALEXA_RENDERER_STATE_FILE=/var/lib/castnavidrome/renderer-devices.json

# ---- Debug endpoints (optional) ----
NAVI_DEBUG_TOKEN=
NAVI_DEBUG=0

# ---- Radio / streams (optional) ----
NAVI_RADIO_URL=
NAVI_RADIO_STATIONS_URL=

# ---- Playlist discovery formatting (optional) ----
NAVI_PLAYLIST_NAME_PATTERN=
NAVI_PLAYLIST_SPOKEN_FORMAT=
NAVI_PLAYLIST_QUALIFIED_FORMAT=

# ---- Amazon login (replaces manual cookie copy) ----
# Set NAVI_AMAZON_USER / NAVI_AMAZON_PASS / NAVI_AMAZON_TOTP_SECRET (env var or
# Docker secret) to log in automatically. Leave unset to keep the cookie file
# fallback (NAVI_ALEXA_COOKIE_FILE).
# NAVI_AMAZON_USER=
# NAVI_AMAZON_PASS=
# NAVI_AMAZON_TOTP_SECRET=
# NAVI_AMAZON_SESSION_FILE=/var/lib/castnavidrome/amazon_session.json

# Path to an Alexa cookie file (one name=value cookie per line, incl. csrf).
# Keep this file private; never commit it.
NAVI_ALEXA_COOKIE_FILE=/run/secrets/alexa.cookies
