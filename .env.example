# castNavidrome - example configuration
# Copy this file to .env and fill in your own values.  Never commit .env.

# ---- Service / Tailscale ----
SERVICE=castnavidrome
SERVICEPORT=5000
TS_AUTHKEY=your-tailscale-authkey # required
TS_CERT_DOMAIN=your-service.example.test # required

# ---- Navidrome (Subsonic API) - required ----
NAVI_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
NAVI_URL=https://navidrome.example.test
NAVI_BASE_URL=https://castnavidrome.example.test
NAVI_USER=your-navidrome-username
NAVI_PASS=your-navidrome-password

# ---- Alexa skill - required ----
NAVI_ALEXA_API_KEY=your-api-key-here #required
NAVI_ALEXA_DOMAIN=amazon.de
NAVI_ALEXA_LOCALE=de-DE
NAVI_ALEXA_SKILL_NAME="cast navidrome" #must match invocation name in skill developer console (json file)

# ---- Media Renderer ----
# NAVI_ALEXA_RENDERER_ENABLED=yes
# NAVI_ALEXA_RENDERER_ADVERTISE_HOST=
# NAVI_ALEXA_RENDERER_PORT=49443
# NAVI_ALEXA_RENDERER_REFRESH_SECONDS=300
# NAVI_ALEXA_RENDERER_MIN_REFRESH_SECONDS=60
# NAVI_ALEXA_RENDERER_NAME_PREFIX=
# NAVI_ALEXA_RENDERER_DEVICE_TYPES=
# NAVI_ALEXA_RENDERER_EXCLUDED_DEVICE_TYPES=
# NAVI_ALEXA_RENDERER_NAME_INCLUDE=
# NAVI_ALEXA_RENDERER_NAME_EXCLUDE= #e.g. "This Device"
# NAVI_ALEXA_RENDERER_NAME_REGEX=
# NAVI_ALEXA_RENDERER_ONLY_ONLINE=no
# NAVI_ALEXA_RENDERER_ANNOUNCE=explicit
# NAVI_ALEXA_RENDERER_LOG_LEVEL=INFO
# NAVI_ALEXA_RENDERER_ANNOUNCE_INTERVAL=720
# NAVI_ALEXA_RENDERER_SSDP_MX=2 # Maximum Wait Time for M-SEARCH responses (0 = immediate)
# NAVI_ALEXA_RENDERER_DISABLE_REFRESH=true
# NAVI_ALEXA_RENDERER_DISABLE_BYEBYE=true # disable byebye if client does not find the player.
# NAVI_ALEXA_RENDERER_CLIENT_TIMEOUT=0 # seconds of client inactivity after which playback stops (0 = disabled)
# NAVI_ALEXA_RENDERER_DISABLE_ANNOUNCE=false # disable periodic SSDP announcements (true/false)
# NAVI_ALEXA_RENDERER_ANNOUNCE_INTERVAL=720 # seconds between periodic SSDP announcements (<= 0 disables)
# NAVI_ALEXA_RENDERER_NOTIFY_COUNT=3 # number of times ssdp:alive/byebye is repeated (0 = no repeats)
# NAVI_ALEXA_RENDERER_NOTIFY_DELAY=0.4 # seconds between SSDP notify repetitions (0 = no delay)

# Amazon OAuth (official Login with Amazon flow, replaces the screen-scraped /ap/signin)
# Register a "Login with Amazon" security profile in the Amazon developer console.
# The OAuth credentials are required when the OAuth flow is used; the scope
# defaults to "profile" when NAVI_AMAZON_SCOPES is not set.
# NAVI_AMAZON_CLIENT_ID=amzn1.application-oa2-client.00000000000000000000000000000000
# NAVI_AMAZON_CLIENT_SECRET=your-client-secret
# NAVI_AMAZON_REDIRECT_URI=https://castnavidrome.example.test/api/alexa/amazon/callback
# NAVI_AMAZON_TOKEN_FILE=/var/lib/castnavidrome/amazon_oauth_token.json
# NAVI_AMAZON_SCOPES=profile
# NAVI_AMAZON_SESSION_FILE=/var/lib/castnavidrome/amazon_session.json
# NAVI_ALEXA_DOMAIN=amazon.de
# Automatischer Container-Neustart nach erfolgreichem OAuth-Token-Save.
# Aktiviert: docker compose restart (durch restart: unless-stopped).
# NAVI_AUTO_RESTART_ON_OAUTH_TOKEN_SAVE=true

# ---- Navidrome API details ----
# NAVI_PORT=443
# NAVI_API_PATH=/rest
# NAVI_API_VER=1.16.1
# NAVI_API_TIMEOUT=10

# ---- Debug / Logging ----
# NAVI_DEBUG=0
# NAVI_LOG_LEVEL=INFO